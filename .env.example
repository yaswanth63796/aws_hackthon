# AquaGuard Environment Configuration Example
# Copy this file to .env to configure local settings or cloud integrations.
#
# IMPORTANT SECURITY REMINDER:
# NEVER commit production AWS credentials, secret keys, or passwords.
# Frontend applications should communicate strictly with secure endpoints (e.g., API Gateway).

# Set to 'true' to redirect water telemetry requests to an active AWS API Gateway endpoint
# Set to 'false' (default) to run the self-contained local simulated telemetry engine
VITE_USE_AWS_API=false

# Base URL for the deployed AWS API Gateway REST API (e.g. stage: /dev or /prod)
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_API_BASE_URL=https://lgizyb01d3.execute-api.eu-north-1.amazonaws.com

# Optional API Gateway API Key header (x-api-key) if required by usage plan


# Optional AWS Region where backend Lambda / DynamoDB resources are deployed
VITE_AWS_REGION=us-east-1
